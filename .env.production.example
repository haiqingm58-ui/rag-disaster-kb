# 生产环境 .env 模板
# 用法：
#   cp .env.production.example .env
#   python scripts/gen_secrets.py   # 生成 JWT_SECRET 和 AUTH_PASSWORD
#   nano .env                       # 把生成的强随机值粘进去，再填 API Key
#
# 部署前 settings.py 会做以下守卫，配错会启动失败：
#   - APP_ENV=production 时，JWT_SECRET 不能含 "change-this"
#   - APP_ENV=production 时，AUTH_PASSWORD 不能是 admin123
#   - APP_ENV=production 时，CORS_ORIGINS 不能为空

# ============================================================
# 应用
# ============================================================
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_UPLOAD_MB=30
GRAPH_TOP_K=80
DISASTER_CACHE_TTL_SECONDS=1800
LOG_LEVEL=INFO
LOG_TO_FILE=true
CORS_ORIGINS=https://georisklab.com.cn
# 受信任的 Host 头白名单，TrustedHostMiddleware 用。逗号分隔。
# 必须同时包含：
#   - 外部访问的域名（含 www 子域，如果你启用了的话）
#   - 127.0.0.1（uvicorn 监听这里，nginx 和 systemd 的内部健康检查走 127.0.0.1）
#   - localhost（脚本里习惯写 localhost 的健康检查）
#   - 允许直连公网 IP 时也写上，否则可省
TRUSTED_HOSTS=georisklab.com.cn,www.georisklab.com.cn,127.0.0.1,localhost

# ============================================================
# 鉴权 & 限流
# ============================================================
AUTH_USERNAME=admin
# 用 python scripts/gen_secrets.py 生成
AUTH_PASSWORD=REPLACE_WITH_STRONG_RANDOM
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_EXPIRE_MINUTES=480
CHAT_RATE_LIMIT_PER_MINUTE=20

REGISTRATION_DEFAULT_ROLE=user
REGISTRATION_CODE_EXPIRE_MINUTES=10
REGISTRATION_CODE_SEND_INTERVAL_SECONDS=60

# ============================================================
# SMTP（注册验证码邮件）
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=12

# ============================================================
# LLM：DeepSeek API
# ============================================================
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

# ============================================================
# Embedding：2G 服务器优先用远程 embedding，避免本机跑 Ollama
# ============================================================
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=text-embedding-3-small

CHROMA_DIR=/opt/rag-disaster-kb/data/chroma_db

# ============================================================
# 实时灾害定时同步：生产建议打开
# ============================================================
DISASTER_SCHEDULER_ENABLED=true
DISASTER_SCHEDULER_INTERVAL_MINUTES=60
DISASTER_SCHEDULER_STARTUP_DELAY_SECONDS=60
DISASTER_SCHEDULER_RUN_ON_START=false

# ============================================================
# 2C2G 性能调优
# ============================================================
RAG_CONTEXT_CHAR_BUDGET=4500
RAG_CONTEXT_ITEM_CHAR_LIMIT=700
FIRECRAWL_CACHE_TTL_SECONDS=3600
WEB_SEARCH_TIMEOUT_SECONDS=4

# Firecrawl 可选；不配置时自动跳过。
FIRECRAWL_API_KEY=

# 城市地理编码
GEOCODER_PROVIDER=nominatim
GEOCODER_CACHE_TTL_HOURS=24
GEOCODER_USER_AGENT=georisk-disaster-query/1.0

# ============================================================
# Neo4j 知识图谱：2G 机器默认不开
# ============================================================
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
